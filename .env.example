# MongoDB
MONGODB_URI=mongodb+srv://user:pass@cluster0.mongodb.net/myFirstDatabase?retryWrites=true&w=majority

# JWT — use a strong random secret, min 32 chars
JWT_SECRET=replace-with-strong-secret-min-32-chars

# Site
SITE_URL=https://steptosoft.com

# SMTP (Gmail app password)
SMTP_USER=steptosoft@gmail.com
SMTP_PASS=your-app-password

# Admin notification emails (comma-separated)
ADMIN_EMAILS=hr@steptosoft.com,info@steptosoft.com
